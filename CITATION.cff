# Citation metadata for pg_gpu-paper-analysis.
#
# When the preprint is posted, fill in the bioRxiv DOI under the
# "preferred-citation" block below; until then, citations resolve to
# this repository.
cff-version: 1.2.0
title: "pg_gpu-paper-analysis: reproducibility scripts for the pg_gpu paper"
message: "If you use this software, please cite both this repository and the pg_gpu paper (when available)."
type: software
authors:
  - family-names: Kern
    given-names: Andrew D.
    email: adk@uoregon.edu
    affiliation: "Institute of Ecology and Evolution, University of Oregon"
repository-code: "https://github.com/kr-colab/pg_gpu-paper-analysis"
url: "https://github.com/kr-colab/pg_gpu-paper-analysis"
license: MIT
keywords:
  - population genetics
  - GPU
  - reproducibility
  - linkage disequilibrium
  - site frequency spectrum
  - biobank
abstract: >-
  Reproducibility scripts and figures for the pg_gpu paper. Each
  top-level directory is one paper section, with scripts that produce
  the figures and tables in that section. Covers numerical accuracy
  against scikit-allel / PLINK / moments, wall-clock benchmarks on
  real Ag1000G data, sample-size and variant-count scaling, the
  Achaz (2009) neutrality test framework, an end-to-end Ag1000G
  workflow, and a biobank-scale simulated genome scan using the
  pg_gpu streaming API.
preferred-citation:
  # TODO: replace with the bioRxiv DOI when the preprint is posted.
  type: article
  title: "pg_gpu: GPU-accelerated population genetics for biobank-scale data"
  authors:
    - family-names: Kern
      given-names: Andrew D.
  year: 2026
  journal: "bioRxiv"
  doi: "TBD"
